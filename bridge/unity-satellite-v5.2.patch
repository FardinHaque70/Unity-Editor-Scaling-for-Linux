+
+impl EwmhClients {
+    fn mapped(&mut self, window: x::Window, managed: bool) {
+        if !managed {
+            self.withdrawn(window);
+        } else if !self.map_order.contains(&window) {
+            self.map_order.push(window);
+        }
+    }
+
+    fn withdrawn(&mut self, window: x::Window) {
+        self.map_order.retain(|candidate| *candidate != window);
+    }
+
+    fn stacking(&self, root_children: &[x::Window]) -> Vec<x::Window> {
+        // QueryTree returns immediate children from bottom to top. Restrict it
+        // to managed clients, excluding override-redirect and helper windows.
+        root_children
+            .iter()
+            .copied()
+            .filter(|window| self.map_order.contains(window))
+            .collect()
+    }
+}
