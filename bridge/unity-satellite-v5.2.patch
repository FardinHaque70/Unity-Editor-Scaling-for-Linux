+fn parse_fixed_render_scale(value: Option<&str>) -> Result<Option<i32>, &'static str> {
+    match value {
+        None => Ok(None),
+        Some(value) => value
+            .parse::<i32>()
+            .ok()
+            .filter(|scale| (1..=4).contains(scale))
+            .map(Some)
+            .ok_or("UNITY_SATELLITE_RENDER_SCALE must be an integer from 1 to 4"),
+    }
