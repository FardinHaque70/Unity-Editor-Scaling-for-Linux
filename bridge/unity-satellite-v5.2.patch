+impl State {
+    fn record_cursor(&mut self, surface: Option<WlSurface>, x: i32, y: i32) -> Option<CursorData> {
+        surface.map(|surface| {
+            let surface = SurfaceId::from(&surface);
+            let data = self.surfaces.get_mut(&surface).unwrap();
+            assert!(matches!(
+                data.role.replace(SurfaceRole::Cursor),
+                None | Some(SurfaceRole::Cursor)
+            ));
+            CursorData {
+                surface,
+                hotspot: Vec2 { x, y },
+            }
+        })
+    }
+}
