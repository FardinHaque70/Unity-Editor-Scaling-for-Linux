+fn parse_ui_multiplier(
+    value: Option<&str>,
+    render_scale: Option<i32>,
+) -> Result<f64, &'static str> {
+    let Some(value) = value else {
+        return Ok(1.0);
+    };
+    let Some(render_scale) = render_scale else {
+        return Err("UNITY_SATELLITE_UI_MULTIPLIER requires UNITY_SATELLITE_RENDER_SCALE");
+    };
+    value.parse::<f64>().ok().filter(|multiplier| {
+        let mapping = f64::from(render_scale) / multiplier;
+        multiplier.is_finite() && *multiplier > 0.0 && mapping.is_finite() && mapping > 0.0
+    }).ok_or("UNITY_SATELLITE_UI_MULTIPLIER must be a finite positive number with a finite mapping scale")
+}
