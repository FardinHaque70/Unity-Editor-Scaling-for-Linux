+#[test]
+fn ewmh_client_lists_follow_managed_lifecycle_and_real_stacking() {
+    let a = x::Window::new(10);
+    let b = x::Window::new(11);
+    let c = x::Window::new(12);
+    let popup = x::Window::new(13);
+    let helper = x::Window::new(14);
+    let mut clients = EwmhClients::default();
+    assert!(clients.map_order.is_empty());
+    assert!(clients.stacking(&[helper, popup]).is_empty());
+    clients.mapped(a, true);
+    clients.mapped(popup, false); // Override-redirect menus/drag ghosts.
+    clients.mapped(helper, false); // WM/selection InputOnly helpers.
+    clients.mapped(b, true); // Managed dialog/utility clients count too.
+    clients.mapped(a, true); // Duplicate MapNotify must not reorder or duplicate.
+    clients.mapped(c, true);
+    assert_eq!(clients.map_order, vec![a, b, c]);
+    assert_eq!(clients.stacking(&[helper, a, popup, b, c]), vec![a, b, c]);
+    // A native raise changes only the QueryTree stacking order, preserving the
+    // EWMH initial-map order and excluding helper/override-redirect windows.
+    assert_eq!(clients.stacking(&[helper, b, popup, c, a]), vec![b, c, a]);
+    assert_eq!(clients.map_order, vec![a, b, c]);
+    clients.withdrawn(b); // Unmap/destroy/reparent-away share withdrawal semantics.
+    clients.withdrawn(b); // Duplicate lifecycle events are harmless.
+    assert_eq!(clients.map_order, vec![a, c]);
+    clients.mapped(b, true);
+    assert_eq!(clients.map_order, vec![a, c, b]);
+    assert_eq!(clients.stacking(&[helper, b, a, popup, c]), vec![b, a, c]);
+    clients.mapped(b, false); // A remap that became unmanaged must remove it.
+    assert_eq!(clients.map_order, vec![a, c]);
+    for window in [a, b, c] {
+        clients.withdrawn(window);
+    }
+    assert!(clients.map_order.is_empty());
+    assert!(clients.stacking(&[a, b, c, helper, popup]).is_empty());
+}
