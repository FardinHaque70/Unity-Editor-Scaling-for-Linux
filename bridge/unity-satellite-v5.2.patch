+fn scale_output_coordinate(value: i32, scale: f64) -> i32 {
+    (f64::from(value) * scale).round() as i32
+}
+
+fn update_fixed_output_geometry(
+    output: &WlOutput,
+    xdg: Option<&XdgOutputServer>,
+    dimensions: &mut OutputDimensions,
+    scale: f64,
+) {
+    let Some((logical_width, logical_height)) = dimensions.host_logical_size else {
+        return;
+    };
+    // Transform shared rectangle edges once, rather than independently rounding
+    // origin and extent, so adjacent monitors cannot gain a one-pixel gap.
+    let extent = |origin: i32, length: i32| {
+        ((f64::from(origin) + f64::from(length)) * scale).round()
+            - (f64::from(origin) * scale).round()
+    };
+    let width = extent(dimensions.host_logical_position.0, logical_width) as i32;
+    let height = extent(dimensions.host_logical_position.1, logical_height) as i32;
+    (dimensions.width, dimensions.height) = if dimensions.rotated_90 {
+        (height, width)
+    } else {
+        (width, height)
+    };
+    if let Some(mode) = dimensions.host_mode {
+        output.mode(
+            convert_wenum(mode.flags),
+            dimensions.width,
+            dimensions.height,
+            mode.refresh,
+        );
+    }
+    if let Some(xdg) = xdg {
+        xdg.logical_size(width, height);
+        if xdg.version() < 3 {
+            xdg.done();
+        }
+    }
+    output.done();
+}
